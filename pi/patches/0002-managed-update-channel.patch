+import { type ChildProcess, type SpawnOptions, spawn } from "node:child_process";
+import { readFileSync, statSync } from "node:fs";
+import { isAbsolute, join } from "node:path";
+import { getPackageDir } from "../config.ts";
+import { waitForChildProcess } from "../utils/child-process.ts";
+
+interface ManagedUpdateHelpers {
+	getPackageDir(): string;
+	readFileSync(path: string, encoding: "utf8"): string;
+	statSync(path: string): { isDirectory(): boolean };
+	spawn(command: string, args: string[], options: SpawnOptions): ChildProcess;
+	waitForChildProcess(child: ChildProcess): Promise<number | null>;
+}
+
+// Only an absent marker permits the stock updater; broken channels must fail closed.
+export async function runManagedChannelUpdate(
+	force: boolean,
+	helpers: ManagedUpdateHelpers = { getPackageDir, readFileSync, statSync, spawn, waitForChildProcess },
+): Promise<boolean> {
+	const markerPath = join(helpers.getPackageDir(), "hempi-channel.json");
+	let content: string;
+	try {
+		content = helpers.readFileSync(markerPath, "utf8");
+	} catch (error: unknown) {
+		if (error instanceof Error && "code" in error && error.code === "ENOENT") return false;
+		throw error;
+	}
+
+	let marker: { format: number; root: string; node: string };
+	try {
+		marker = JSON.parse(content);
+		if (
+			marker?.format !== 1 ||
+			typeof marker.root !== "string" ||
+			!isAbsolute(marker.root) ||
+			typeof marker.node !== "string" ||
+			!isAbsolute(marker.node) ||
+			!helpers.statSync(marker.root).isDirectory()
+		) {
+			throw new Error("Invalid channel");
+		}
+	} catch {
+		throw new Error(`Invalid managed update channel: ${markerPath}`);
+	}
+
+	const code = await helpers.waitForChildProcess(
+		helpers.spawn(marker.node, [join(marker.root, "pi", "channel.mjs"), "update", ...(force ? ["--force"] : [])], {
+			cwd: marker.root,
+			shell: false,
+			stdio: "inherit",
+		}),
+	);
+	if (code !== 0) throw new Error(`Managed channel update exited with code ${code ?? "unknown"}`);
+	return true;
+}
