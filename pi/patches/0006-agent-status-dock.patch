@@ -0,0 +1,258 @@
+import { Container, Text, type TUI, TuiAltScreen, type TuiMouseEvent, VStack } from "@earendil-works/pi-tui";
+import { describe, expect, test, vi } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import { AgentStatusDock } from "../src/modes/interactive/agent-status-dock.ts";
+import { createChatViewport } from "../src/modes/interactive/chat-viewport.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+
+function fixture() {
+	const terminal = new VirtualTerminal(40, 18);
+	const tui = new TuiAltScreen(terminal);
+	let expanded = false;
+	const events: TuiMouseEvent[] = [];
+	const panel = {
+		render: (width: number) => [
+			`${" ".repeat(Math.max(0, width - 6))}Agents`,
+			...(expanded
+				? [`${" ".repeat(Math.max(0, width - 10))}body one`, `${" ".repeat(Math.max(0, width - 10))}body two`]
+				: []),
+		],
+		invalidate: vi.fn(),
+		dispose: vi.fn(),
+		handleMouse: (event: TuiMouseEvent) => {
+			events.push(event);
+			if (event.y === 0 && event.type === "press") expanded = !expanded;
+			return { handled: true, capture: event.type === "press", focus: false };
+		},
+	};
+	const editor = new Text("top border\ninput\nbottom border", 0, 0);
+	const below = new Text("below", 0, 0);
+	const footer = new Text("footer\nfooter two", 0, 0);
+	const dock = new AgentStatusDock(panel, tui, () => "Thinking");
+	const viewport = createChatViewport({
+		document: new Text(Array.from({ length: 30 }, (_, i) => `transcript ${i}`).join("\n"), 0, 0),
+		pendingMessages: new Container(),
+		status: new Container(),
+		widgetsAbove: dock,
+		editor,
+		widgetsBelow: below,
+		footer,
+		scrollbar: "hidden",
+	});
+	tui.setLayoutRoot(viewport.root);
+	tui.setFocus(editor);
+	return {
+		terminal,
+		tui,
+		panel,
+		editor,
+		below,
+		footer,
+		dock,
+		events,
+		transcript: viewport.transcript,
+		expand: () => {
+			expanded = true;
+		},
+	};
+}
+
+describe("private agent status dock", () => {
+	test("shares one row without a spacer; expansion overlays upward without reflow or focus changes", async () => {
+		const f = fixture();
+		f.dock.showOverlay();
+		f.tui.start();
+		try {
+			await f.terminal.waitForRender();
+			const before = f.terminal.getViewport();
+			expect(before[11]).toBe(`Thinking${" ".repeat(26)}Agents`);
+			expect(before[12].trimEnd()).toBe("top border");
+			f.expand();
+			f.tui.requestRender();
+			await f.terminal.waitForRender();
+			const after = f.terminal.getViewport();
+			expect(after.slice(11)).toEqual(before.slice(11));
+			expect(after[9].trimEnd()).toContain("body one");
+			expect(after[10].trimEnd()).toContain("body two");
+			expect(after[9].slice(0, 10)).toBe(before[9].slice(0, 10));
+			expect(f.tui.getFocusedComponent()).toBe(f.editor);
+			f.dock.hideOverlay();
+			f.tui.requestRender();
+			await f.terminal.waitForRender();
+			expect(f.terminal.getViewport()).toEqual(before);
+		} finally {
+			f.dock.hideOverlay();
+			f.tui.stop();
+		}
+	});
+
+	test("reanchors using multiline editor, below-widget, footer and terminal heights each frame", async () => {
+		const f = fixture();
+		f.expand();
+		f.dock.showOverlay();
+		f.tui.start();
+		try {
+			await f.terminal.waitForRender();
+			f.editor.setText("top border\none\ntwo\nthree\nbottom border");
+			f.below.setText("below\nbelow two");
+			f.footer.setText("footer");
+			f.terminal.resize(50, 22);
+			f.tui.requestRender();
+			await f.terminal.waitForRender();
+			const lines = f.terminal.getViewport();
+			const row = lines.findIndex((line) => line.includes("Agents"));
+			expect(row).toBe(22 - 5 - 2 - 1 - 1);
+			expect(lines[row - 1]).toContain("body two");
+			expect(lines[row + 1].trimEnd()).toBe("top border");
+			expect(lines[row]).toHaveLength(50);
+		} finally {
+			f.dock.hideOverlay();
+			f.tui.stop();
+		}
+	});
+
+	test("routes body wheel and dock header mouse coordinates without stealing editor focus", async () => {
+		const f = fixture();
+		f.expand();
+		f.dock.showOverlay();
+		f.tui.start();
+		try {
+			await f.terminal.waitForRender();
+			f.terminal.sendInput("\x1b[<65;35;11M");
+			await f.terminal.waitForRender();
+			const wheel = f.events.find((event) => event.type === "wheel");
+			expect(wheel).toMatchObject({ x: 34, y: 2, width: 40, height: 3, wheelDelta: 1 });
+			f.terminal.sendInput("\x1b[<0;36;12M");
+			f.terminal.sendInput("\x1b[<0;36;12m");
+			await f.terminal.waitForRender();
+			expect(f.events.some((event) => event.type === "press" && event.y === 0)).toBe(true);
+			expect(f.events.some((event) => event.type === "release" && event.y === 0)).toBe(true);
+			expect(f.tui.getFocusedComponent()).toBe(f.editor);
+		} finally {
+			f.dock.hideOverlay();
+			f.tui.stop();
+		}
+	});
+
+	test("clips upward on short terminals and keeps logical body mouse rows", async () => {
+		const f = fixture();
+		f.expand();
+		f.terminal.resize(40, 8);
+		f.dock.showOverlay();
+		f.tui.start();
+		try {
+			await f.terminal.waitForRender();
+			const lines = f.terminal.getViewport();
+			expect(lines[0]).toContain("body two");
+			expect(lines[1]).toContain("Agents");
+			expect(lines[2].trimEnd()).toBe("top border");
+			f.terminal.sendInput("\x1b[<65;35;1M");
+			await f.terminal.waitForRender();
+			expect(f.events.find((event) => event.type === "wheel")?.y).toBe(2);
+			f.terminal.resize(40, 7);
+			f.tui.requestRender();
+			await f.terminal.waitForRender();
+			const shrunk = f.terminal.getViewport();
+			const header = shrunk.findIndex((line) => line.includes("Agents"));
+			expect(header).toBeGreaterThanOrEqual(0);
+			if (header > 0) expect(shrunk[header - 1]).toContain("body two");
+		} finally {
+			f.dock.hideOverlay();
+			f.tui.stop();
+		}
+	});
+
+	test("passive details preserve scroll-aware transcript selection outside the panel", async () => {
+		const f = fixture();
+		f.expand();
+		f.dock.showOverlay();
+		f.tui.start();
+		try {
+			await f.terminal.waitForRender();
+			f.terminal.sendInput("\x1b[<0;2;9M");
+			await f.terminal.waitForRender();
+			expect(Reflect.get(f.tui, "selectionAnchor")?.scrollView).toBe(f.transcript);
+		} finally {
+			f.dock.hideOverlay();
+			f.tui.stop();
+		}
+	});
+
+	test("dock recreated during a modal stays behind it", async () => {
+		const f = fixture();
+		f.expand();
+		f.dock.showOverlay();
+		f.tui.start();
+		let modal: ReturnType<TUI["showOverlay"]> | undefined;
+		try {
+			await f.terminal.waitForRender();
+			modal = f.tui.showOverlay(new Text("MODAL", 0, 0), { row: 10, col: 30, width: 10 });
+			f.dock.showOverlay();
+			await f.terminal.waitForRender();
+			expect(f.terminal.getViewport()[10]).toContain("MODAL");
+		} finally {
+			modal?.hide();
+			f.dock.hideOverlay();
+			f.tui.stop();
+		}
+	});
+
+	test("the native panel overlay does not block switching to regular mode", () => {
+		const f = fixture();
+		f.dock.showOverlay();
+		const ctx = Object.assign(Object.create(InteractiveMode.prototype), {
+			renderer: f.tui,
+			agentStatusDock: f.dock,
+			options: {},
+		});
+		Object.defineProperty(ctx, "settingsManager", {
+			value: { getFullscreenCopyOnSelect: () => false, getFullscreenWheelScrollLines: () => 3 },
+		});
+		const switchMode = Reflect.get(InteractiveMode.prototype, "switchTuiMode");
+		expect(switchMode.call(ctx, "regular", false, false)).toBe(true);
+		expect(ctx.renderer.mode).toBe("regular");
+		expect(f.tui.hasOverlayEntries).toBe(false);
+		expect(ctx.renderer.hasOverlayEntries).toBe(false);
+	});
+
+	test("regular mode keeps body inline above the shared dock", () => {
+		const panel = { render: () => ["      Agents", "body"], invalidate() {} };
+		const ui = { mode: "regular", terminal: { columns: 12, rows: 10 } } as TUI;
+		const dock = new AgentStatusDock(panel, ui, () => "Work");
+		expect(dock.render(12)).toEqual(["body", "Work  Agents"]);
+	});
+
+	test("InteractiveMode privately intercepts only the reserved key and cleans up on replacement/removal", () => {
+		const f = fixture();
+		const ctx = Object.assign(Object.create(InteractiveMode.prototype), {
+			ui: f.tui,
+			extensionWidgetsAbove: new Map(),
+			extensionWidgetsBelow: new Map(),
+			widgetContainerAbove: new VStack(),
+			widgetContainerBelow: new Container(),
+			statusContainer: new Container(),
+			editorContainer: new Container(),
+			footerContainer: new Container(),
+			defaultEditor: { setWorkingStatusIndicator: vi.fn() },
+			editor: {},
+			activeStatusIndicator: { renderInBorder: () => "Working" },
+		});
+		const setWidget = Reflect.get(InteractiveMode.prototype, "setExtensionWidget");
+		setWidget.call(ctx, "hempi.agent-panel", () => f.panel, { placement: "aboveEditor" });
+		expect(ctx.widgetContainerAbove.children).toHaveLength(1);
+		expect(ctx.widgetContainerAbove.render(40)).toEqual([`Working${" ".repeat(27)}Agents`]);
+		expect(ctx.statusContainer.children).toHaveLength(0);
+		setWidget.call(ctx, "other", ["ordinary"], { placement: "aboveEditor" });
+		expect(ctx.widgetContainerAbove.children).toHaveLength(2);
+		setWidget.call(ctx, "hempi.agent-panel", undefined);
+		expect(f.panel.dispose).toHaveBeenCalledTimes(1);
+		expect(f.tui.hasOverlayEntries).toBe(false);
+		expect(ctx.statusContainer.children).toHaveLength(1);
+		expect(ctx.widgetContainerAbove.children).toHaveLength(2); // Ordinary widget retains its stock spacer.
+		setWidget.call(ctx, "hempi.agent-panel", () => f.panel, { placement: "aboveEditor" });
+		Reflect.get(InteractiveMode.prototype, "clearExtensionWidgets").call(ctx);
+		expect(f.panel.dispose).toHaveBeenCalledTimes(2);
+		expect(f.tui.hasOverlayEntries).toBe(false);
+		expect(ctx.extensionWidgetsAbove.size).toBe(0);
+	});
+});
