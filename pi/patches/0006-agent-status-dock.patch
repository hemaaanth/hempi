+import {
+	type Component,
+	isViewportTUI,
+	type OverlayHandle,
+	sliceByColumn,
+	type TUI,
+	type TuiMouseEvent,
+	truncateToWidth,
+	visibleWidth,
+} from "@earendil-works/pi-tui";
+
+/** Private hempi.agent-panel contract: header first, then logical body rows 1..N. */
+export class AgentStatusDock implements Component {
+	private lines: string[] = [];
+	private bodyLeft = 0;
+	private bodyStart = 1;
+	private overlay: OverlayHandle | undefined;
+
+	private readonly panel: Component;
+	private readonly ui: TUI;
+	private readonly status: (width: number) => string;
+	constructor(panel: Component, ui: TUI, status: (width: number) => string) {
+		this.panel = panel;
+		this.ui = ui;
+		this.status = status;
+	}
+
+	private refresh(): void {
+		this.lines = this.panel.render(this.ui.terminal.columns);
+		const body = this.lines.slice(1).filter((line) => visibleWidth(line) > 0);
+		this.bodyLeft = body.length ? Math.min(...body.map((line) => line.match(/^ */)![0].length)) : 0;
+	}
+
+	private get bottom(): number {
+		const bounds = isViewportTUI(this.ui) ? this.ui.getComponentBounds(this) : undefined;
+		return bounds ? this.ui.terminal.rows - bounds.row : this.ui.terminal.rows;
+	}
+
+	showOverlay(): void {
+		this.hideOverlay();
+		const dock = this;
+		this.overlay = this.ui.showOverlay(
+			{
+				render(width) {
+					const capacity = Math.max(0, dock.ui.terminal.rows - dock.bottom);
+					dock.bodyStart = Math.max(1, dock.lines.length - capacity);
+					return dock.lines.slice(dock.bodyStart).map((line) => sliceByColumn(line, dock.bodyLeft, width));
+				},
+				handleMouse(event) {
+					return dock.mouse(event, event.x + dock.bodyLeft, event.y + dock.bodyStart);
+				},
+				invalidate: () => dock.invalidate(),
+			},
+			{
+				anchor: "bottom-right",
+				background: true,
+				get width() {
+					return Math.max(1, dock.ui.terminal.columns - dock.bodyLeft);
+				},
+				get margin() {
+					return { bottom: dock.bottom };
+				},
+				nonCapturing: true,
+				visible: () => {
+					dock.refresh();
+					return dock.ui.mode === "fullscreen" && dock.lines.length > 1 && dock.bottom < dock.ui.terminal.rows;
+				},
+			},
+		);
+	}
+
+	hideOverlay(): void {
+		this.overlay?.hide();
+		this.overlay = undefined;
+	}
+
+	invalidate(): void {
+		this.panel.invalidate();
+	}
+
+	render(width: number): string[] {
+		this.refresh();
+		const header = this.lines[0] ?? "";
+		const indent = header.match(/^ */)![0].length;
+		const right = header.slice(indent);
+		const rightWidth = visibleWidth(right);
+		const left = truncateToWidth(
+			this.status(Math.max(0, width - rightWidth - 1)),
+			Math.max(0, width - rightWidth - 1),
+			"",
+		);
+		const row = left + " ".repeat(Math.max(0, width - visibleWidth(left) - rightWidth)) + right;
+		return this.ui.mode === "fullscreen" ? [row] : [...this.lines.slice(1), row];
+	}
+
+	private mouse(event: TuiMouseEvent, x: number, y: number) {
+		const result = this.panel.handleMouse?.({
+			...event,
+			x,
+			y,
+			width: this.ui.terminal.columns,
+			height: this.lines.length,
+		});
+		return result ? { ...result, focus: false } : undefined;
+	}
+
+	handleMouse(event: TuiMouseEvent) {
+		const y = this.ui.mode === "fullscreen" ? 0 : event.y === this.lines.length - 1 ? 0 : event.y + 1;
+		return this.mouse(event, event.x, y);
+	}
+}
