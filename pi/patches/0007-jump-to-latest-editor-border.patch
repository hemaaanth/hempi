diff --git a/packages/coding-agent/test/jump-to-latest-dock.test.ts b/packages/coding-agent/test/jump-to-latest-dock.test.ts
new file mode 100644
index 0000000..636f45f
--- /dev/null
+++ b/packages/coding-agent/test/jump-to-latest-dock.test.ts
@@ -0,0 +1,177 @@
+import { Container, getKeybindings, setKeybindings, Text } from "@earendil-works/pi-tui";
+import { expect, test } from "vitest";
+import { defaultEditorTheme } from "../../tui/test/test-themes.ts";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import { KeybindingsManager } from "../src/core/keybindings.ts";
+import { AgentStatusDock } from "../src/modes/interactive/agent-status-dock.ts";
+import { createChatViewport } from "../src/modes/interactive/chat-viewport.ts";
+import { CustomEditor } from "../src/modes/interactive/components/custom-editor.ts";
+import { WorkingStatusIndicator } from "../src/modes/interactive/components/status-indicator.ts";
+import { initTheme } from "../src/modes/interactive/theme/theme.ts";
+import { createInteractiveTui } from "../src/modes/interactive/tui-renderer.ts";
+
+for (const agentDock of [false, true]) {
+	test(`jump hint stays on the editor border below Working (agent dock: ${agentDock})`, async () => {
+		initTheme("dark");
+		const previousKeys = getKeybindings();
+		setKeybindings(new KeybindingsManager({ "tui.altScreen.bottom": "ctrl+j" }));
+		const terminal = new VirtualTerminal(60, 18);
+		const editor = new Text(`${"─".repeat(60)}\ninput\n${"─".repeat(60)}`, 0, 0);
+		const editorContainer = new Container();
+		editorContainer.addChild(editor);
+		const ui = createInteractiveTui({
+			tuiMode: "fullscreen",
+			showHardwareCursor: false,
+			logDirectory: "/tmp",
+			terminal,
+			scrollToEndIndicatorAnchor: () => editorContainer,
+		});
+		const dock = new AgentStatusDock({ render: () => ["Agents"], invalidate() {} }, ui, () => "Working");
+		const viewport = createChatViewport({
+			document: new Text(Array.from({ length: 50 }, (_, i) => `transcript ${i}`).join("\n"), 0, 0),
+			pendingMessages: new Text("pending", 0, 0),
+			status: agentDock ? new Container() : new Text("Working", 0, 0),
+			...(agentDock ? { widgetsAbove: dock } : {}),
+			editor: editorContainer,
+			widgetsBelow: new Text("below", 0, 0),
+			footer: new Text("footer", 0, 0),
+			scrollbar: "always",
+		});
+		ui.setLayoutRoot(viewport.root);
+		ui.setFocus(editor);
+		ui.start();
+		try {
+			await terminal.waitForRender();
+			expect(terminal.getViewport().some((line) => line.includes("Jump to latest"))).toBe(false);
+			terminal.sendInput("\x1b[<64;1;1M");
+			await terminal.waitForRender();
+			let lines = terminal.getViewport();
+			let border = ui.getComponentBounds(editorContainer)!.row;
+			expect(lines[border]).toContain("─ ↓ Jump to latest message · Ctrl+J ─");
+			expect(lines[border - 1]).toContain("Working");
+			expect(lines.filter((line) => line.includes("Jump to latest"))).toHaveLength(1);
+			// The old transcript-bottom hit region must no longer jump.
+			const transcriptBounds = ui.getComponentBounds(viewport.transcript)!;
+			const oldHintRow = transcriptBounds.row + transcriptBounds.height;
+			terminal.sendInput(`\x1b[<0;30;${oldHintRow}M`);
+			terminal.sendInput(`\x1b[<0;30;${oldHintRow}m`);
+			await terminal.waitForRender();
+			expect(viewport.transcript.isFollowingEnd).toBe(false);
+			ui.resetTextSelection();
+			ui.scrollToTop();
+
+			// Wrapped/multiline editor, changing terminal dimensions, and constrained dock allocation.
+			for (const [width, height] of [
+				[48, 22],
+				[24, 10],
+				[60, 18],
+			] as const) {
+				editor.setText(`${"─".repeat(width)}\none\ntwo\nthree\n${"─".repeat(width)}`);
+				terminal.resize(width, height);
+				ui.requestRender();
+				await terminal.waitForRender();
+				lines = terminal.getViewport();
+				border = ui.getComponentBounds(editorContainer)!.row;
+				expect(lines[border]).toContain("↓ Jump to latest");
+				expect(lines[border - 1]).toContain("Working");
+				expect(lines[border + 1].trimEnd()).toBe("one");
+				expect(lines.every((line) => line.length <= width)).toBe(true);
+			}
+			const column = lines[border].indexOf("↓") + 1;
+			terminal.sendInput(`\x1b[<0;${column};${border + 1}M`);
+			terminal.sendInput(`\x1b[<0;${column};${border + 1}m`);
+			await terminal.waitForRender();
+			expect(viewport.transcript.isFollowingEnd).toBe(true);
+			expect(terminal.getViewport()[border].trimEnd()).toBe("─".repeat(60));
+			expect(ui.getFocusedComponent()).toBe(editor);
+
+			terminal.sendInput("\x1b[<64;1;1M");
+			await terminal.waitForRender();
+			terminal.sendInput("\n"); // Configured Ctrl+J action.
+			await terminal.waitForRender();
+			expect(viewport.transcript.isFollowingEnd).toBe(true);
+			expect(terminal.getViewport().some((line) => line.includes("Jump to latest"))).toBe(false);
+		} finally {
+			ui.stop();
+			setKeybindings(previousKeys);
+		}
+	});
+}
+
+for (const clipped of [true, false]) {
+	test(`real focused editor preserves ${clipped ? "clipped input" : "embedded Working status"} instead of painting a hint`, async () => {
+		initTheme("dark");
+		const terminal = new VirtualTerminal(clipped ? 60 : 24, clipped ? 4 : 18);
+		const editorContainer = new Container();
+		const ui = createInteractiveTui({
+			tuiMode: "fullscreen",
+			showHardwareCursor: false,
+			logDirectory: "/tmp",
+			terminal,
+			scrollToEndIndicatorAnchor: () => editorContainer,
+		});
+		const editor = new CustomEditor(ui, defaultEditorTheme, new KeybindingsManager(), {
+			embedWorkingStatus: !clipped,
+		});
+		editor.setText(clipped ? "one\ntwo\nthree\nfour\nfive" : "input");
+		const working = new WorkingStatusIndicator(ui, "Working");
+		working.stop();
+		if (!clipped) editor.setWorkingStatusIndicator(working);
+		editorContainer.addChild(editor);
+		const viewport = createChatViewport({
+			document: new Text(Array.from({ length: 50 }, (_, i) => `transcript ${i}`).join("\n"), 0, 0),
+			pendingMessages: new Container(),
+			status: new Container(),
+			editor: editorContainer,
+			footer: new Container(),
+		});
+		ui.setLayoutRoot(viewport.root);
+		ui.setFocus(editor);
+		ui.start();
+		try {
+			await terminal.waitForRender();
+			const row = ui.getComponentBounds(editorContainer)!.row;
+			const before = terminal.getViewport().slice(row);
+			expect(before[0]).toContain(clipped ? "three" : "Working");
+			terminal.sendInput("\x1b[<64;1;1M");
+			await terminal.waitForRender();
+			expect(viewport.transcript.isFollowingEnd).toBe(false);
+			expect(terminal.getViewport().slice(row)).toEqual(before);
+			expect(terminal.getViewport().some((line) => line.includes("↓ Jump"))).toBe(false);
+			expect(ui.getFocusedComponent()).toBe(editor);
+			terminal.resize(120, 24);
+			ui.scrollToTop();
+			ui.requestRender();
+			await terminal.waitForRender();
+			const border = terminal.getViewport()[ui.getComponentBounds(editorContainer)!.row];
+			expect(border).toContain("↓ Jump to latest");
+			if (!clipped) expect(border).toContain("Working");
+		} finally {
+			working.dispose();
+			ui.stop();
+		}
+	});
+}
+
+test("an unavailable editor anchor hides the hint rather than painting on the transcript", async () => {
+	initTheme("dark");
+	const terminal = new VirtualTerminal(60, 4);
+	const ui = createInteractiveTui({
+		tuiMode: "fullscreen",
+		showHardwareCursor: false,
+		logDirectory: "/tmp",
+		terminal,
+		scrollToEndIndicatorAnchor: () => new Container(),
+	});
+	ui.addChild(new Text(Array.from({ length: 20 }, (_, i) => `line ${i}`).join("\n"), 0, 0));
+	ui.start();
+	try {
+		await terminal.waitForRender();
+		terminal.sendInput("\x1b[<64;1;1M");
+		await terminal.waitForRender();
+		expect(ui.isFollowingOutput).toBe(false);
+		expect(terminal.getViewport().some((line) => line.includes("Jump to latest"))).toBe(false);
+	} finally {
+		ui.stop();
+	}
+});
