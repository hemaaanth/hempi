diff --git a/packages/coding-agent/test/chat-only-settings.test.ts b/packages/coding-agent/test/chat-only-settings.test.ts
new file mode 100644
index 0000000..da632a4
--- /dev/null
+++ b/packages/coding-agent/test/chat-only-settings.test.ts
@@ -0,0 +1,134 @@
+import { fauxAssistantMessage } from "@earendil-works/pi-ai";
+import { Text } from "@earendil-works/pi-tui";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import type { ChatTranscript } from "../src/modes/interactive/chat-transcript.ts";
+import type { SettingsSelectorComponent } from "../src/modes/interactive/components/settings-selector.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { stopThemeWatcher } from "../src/modes/interactive/theme/theme.ts";
+import { createHarness, type Harness } from "./suite/harness.ts";
+
+const invoke = (target: object, method: string, ...args: unknown[]) =>
+	Reflect.apply(Reflect.get(target, method), target, args);
+
+describe("chat-only interactive settings", () => {
+	let harness: Harness | undefined;
+	let mode: InteractiveMode | undefined;
+
+	afterEach(() => {
+		if (mode) {
+			invoke(Reflect.get(mode, "footerDataProvider"), "dispose");
+			invoke(Reflect.get(mode, "ui"), "stop");
+		}
+		stopThemeWatcher();
+		harness?.cleanup();
+		vi.restoreAllMocks();
+	});
+
+	async function createMode(enabled: boolean) {
+		harness = await createHarness({ settings: { chatOnlyTranscript: enabled, theme: "dark" } });
+		const runtime = {
+			session: harness.session,
+			setBeforeSessionInvalidate: vi.fn(),
+			setRebindSession: vi.fn(),
+		} as unknown as AgentSessionRuntime;
+		mode = new InteractiveMode(runtime, { terminal: new VirtualTerminal(80, 24) });
+		return mode;
+	}
+
+	it("creates the native transcript with the saved false value", async () => {
+		const instance = await createMode(false);
+		expect(Reflect.get(instance, "chatContainer").chatOnly).toBe(false);
+		expect(harness!.getPendingResponseCount()).toBe(0);
+	});
+
+	it.each([true, false])("loads saved state before rebuilding chat during /reload (initial %s)", async (initial) => {
+		const instance = await createMode(initial);
+		const chat: ChatTranscript = Reflect.get(instance, "chatContainer");
+		harness!.settingsManager.setChatOnlyTranscript(!initial);
+		await harness!.settingsManager.flush();
+		const ui = Reflect.get(instance, "ui");
+		vi.spyOn(ui, "renderNow").mockImplementation(() => {});
+		vi.spyOn(ui, "requestRender").mockImplementation(() => {});
+		for (const method of [
+			"resetExtensionUI",
+			"setupAutocompleteProvider",
+			"setupExtensionShortcuts",
+			"showLoadedResources",
+			"showStatus",
+			"maybeSaveImplicitProjectTrustAfterReload",
+		])
+			Reflect.set(instance, method, vi.fn());
+		Reflect.set(instance, "themeController", { applyFromSettings: vi.fn() });
+		const rebuild = vi.fn(() => expect(chat.chatOnly).toBe(!initial));
+		Reflect.set(instance, "rebuildChatFromMessages", rebuild);
+		const showError = vi.fn();
+		Reflect.set(instance, "showError", showError);
+		await invoke(instance, "handleReloadCommand");
+		expect(showError).not.toHaveBeenCalled();
+		expect(rebuild).toHaveBeenCalledOnce();
+		expect(chat.chatOnly).toBe(!initial);
+	});
+
+	it("applies the settings menu immediately without replacing native history", async () => {
+		const instance = await createMode(true);
+		const chat: ChatTranscript = Reflect.get(instance, "chatContainer");
+		chat.addChild(new Text("native activity"));
+		const children = [...chat.children];
+		harness!.session.agent.state.messages = [
+			{ role: "user", content: "native prompt", timestamp: 0 },
+			fauxAssistantMessage("native reply"),
+		];
+		const messages = structuredClone(harness!.session.messages);
+		const scroll = {
+			scrollTop: 12,
+			isFollowingEnd: false,
+			scrollToEnd: vi.fn(),
+			scrollTo: vi.fn(),
+		};
+		Reflect.set(instance, "transcriptScrollView", scroll);
+		const ui = Reflect.get(instance, "ui");
+		vi.spyOn(ui, "renderNow").mockImplementation(() => {});
+		vi.spyOn(ui, "requestRender").mockImplementation(() => {});
+		let selector!: SettingsSelectorComponent;
+		Reflect.set(
+			instance,
+			"showSelector",
+			(factory: (done: () => void) => { component: SettingsSelectorComponent }) => {
+				selector = factory(() => {}).component;
+			},
+		);
+		const indicator = { kind: "working", setMessage: vi.fn() };
+		vi.spyOn(harness!.session, "isStreaming", "get").mockReturnValue(true);
+		Reflect.set(instance, "workingVisible", false);
+		Reflect.set(instance, "activeStatusIndicator", indicator);
+		Reflect.set(
+			instance,
+			"clearStatusIndicator",
+			vi.fn(() => Reflect.set(instance, "activeStatusIndicator", undefined)),
+		);
+		const showWorking = vi.fn(() => Reflect.set(instance, "activeStatusIndicator", indicator));
+		Reflect.set(instance, "showWorkingStatusIndicator", showWorking);
+		invoke(instance, "showSettingsSelector");
+		const list = selector.getSettingsList();
+		for (const character of "Chat-only transcript") list.handleInput(character);
+		list.handleInput("\r");
+		expect(chat.chatOnly).toBe(false);
+		expect(Reflect.get(instance, "activeStatusIndicator")).toBeUndefined();
+		expect(harness!.settingsManager.getChatOnlyTranscript()).toBe(false);
+		await harness!.settingsManager.reload();
+		expect(harness!.settingsManager.getChatOnlyTranscript()).toBe(false);
+		scroll.scrollTop = 27;
+		list.handleInput("\r");
+		expect(chat.chatOnly).toBe(true);
+		expect(showWorking).toHaveBeenCalledOnce();
+		expect(indicator.setMessage).toHaveBeenLastCalledWith("Working");
+		expect(harness!.settingsManager.getChatOnlyTranscript()).toBe(true);
+		expect(scroll.scrollTo).toHaveBeenLastCalledWith(12, { disableFollow: true });
+		expect(chat.children).toEqual(children);
+		expect(harness!.session.messages).toEqual(messages);
+		await harness!.settingsManager.reload();
+		expect(harness!.settingsManager.getChatOnlyTranscript()).toBe(true);
+	});
+});
