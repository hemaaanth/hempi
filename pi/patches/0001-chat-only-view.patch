+function message(text: string, stopReason: AssistantMessage["stopReason"] = "stop", tools = false): AssistantMessage {
+	return {
+		role: "assistant",
+		api: "openai-responses",
+		provider: "fake",
+		model: "fake",
+		timestamp: 0,
+		content: [
+			{ type: "thinking", thinking: "SECRET_THOUGHT" },
+			{ type: "text", text },
+			...(tools ? [{ type: "toolCall" as const, id: "call", name: "read", arguments: {} }] : []),
+		],
+		stopReason,
+		usage: {
+			input: 0,
+			output: 0,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 0,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+	};
+}
+
+const output = (chat: ChatTranscript, width = 80) => stripAnsi(chat.render(width).join("\n"));
