+test("native control keys restore the details viewport without changing Ctrl+T", async () => {
+	initTheme("dark");
+	const terminal = new VirtualTerminal(60, 18);
+	const chat = new ChatTranscript();
+	for (let i = 0; i < 20; i++) {
+		chat.addChild(new UserMessageComponent(`INPUT_${i}`));
+		chat.addChild(new Text(`DETAIL_${i}`));
+		chat.addChild(new AssistantMessageComponent(message(`FINAL_${i}`)));
+	}
+	const ui = createInteractiveTui({
+		tuiMode: "fullscreen",
+		terminal,
+		showHardwareCursor: false,
+		logDirectory: "/tmp",
+	});
+	const bindings = new KeybindingsManager();
+	const editor = new CustomEditor(ui, defaultEditorTheme, bindings);
+	const viewport = createChatViewport({
+		document: chat,
+		pendingMessages: new Container(),
+		status: new Container(),
+		editor,
+		footer: new Container(),
+		scrollbar: "hidden",
+	});
+	const context = {
+		chatContainer: chat,
+		transcriptScrollView: viewport.transcript,
+		session: { isStreaming: false },
+		ui,
+		hideThinkingBlock: false,
+		settingsManager: { setHideThinkingBlock: vi.fn() },
+		updateThinkingBlockVisibility() {
+			Reflect.apply(Reflect.get(InteractiveMode.prototype, "updateThinkingBlockVisibility"), this, []);
+		},
+		showStatus: vi.fn(),
+	};
+	editor.onAction("app.transcript.toggle", () => {
+		Reflect.apply(Reflect.get(InteractiveMode.prototype, "toggleChatOnly"), context, []);
+	});
+	editor.onAction("app.thinking.toggle", () => {
+		Reflect.apply(Reflect.get(InteractiveMode.prototype, "toggleThinkingBlockVisibility"), context, []);
+	});
+	ui.setLayoutRoot(viewport.root);
+	ui.start();
+	try {
+		await terminal.waitForRender();
+		editor.handleInput("\x14"); // Ctrl+T keeps its native setting, even while quiet.
+		expect(context.settingsManager.setHideThinkingBlock).toHaveBeenCalledWith(true);
+		expect(chat.chatOnly).toBe(true);
+		editor.handleInput("\x1b[111;6u"); // Kitty Ctrl+Shift+O
+		await terminal.waitForRender();
+		expect(chat.chatOnly).toBe(false);
+		viewport.transcript.scrollTo(12, { disableFollow: true });
+		ui.renderNow();
+		await terminal.waitForRender();
+		const top = viewport.transcript.scrollTop;
+		const details = terminal.getViewport().join("\n");
+		expect(details).toContain("DETAIL_");
+		editor.handleInput("\x1b[111;6u");
+		await terminal.waitForRender();
+		expect(terminal.getViewport().join("\n")).not.toContain("DETAIL_");
+		editor.handleInput("\x1b[111;6u");
+		await terminal.waitForRender();
+		expect(viewport.transcript.scrollTop).toBe(top);
+		expect(viewport.transcript.isFollowingEnd).toBe(false);
+		expect(terminal.getViewport().join("\n")).toBe(details);
+
+		// Navigation replaces the transcript; old details offsets must not survive it.
+		Reflect.apply(
+			Reflect.get(InteractiveMode.prototype, "rebuildChatFromMessages"),
+			{
+				...context,
+				sessionManager: { buildContextEntries: () => [] },
+				renderSessionEntries: () => {
+					for (let i = 0; i < 30; i++) chat.addChild(new UserMessageComponent(`NEW_BRANCH_${i}`));
+				},
+			},
+			[],
+		);
+		expect(chat.transcriptPositions.size).toBe(0);
+		viewport.transcript.scrollToEnd();
+		editor.handleInput("\x1b[111;6u");
+		await terminal.waitForRender();
+		editor.handleInput("\x1b[111;6u");
+		await terminal.waitForRender();
+		expect(viewport.transcript.isFollowingEnd).toBe(true);
+		expect(terminal.getViewport().join("\n")).toContain("NEW_BRANCH_29");
+	} finally {
+		ui.stop();
+	}
+});
