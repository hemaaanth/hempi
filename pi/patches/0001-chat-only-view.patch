@@ -0,0 +1,94 @@
+import { type Component, Container, type TuiMouseEvent } from "@earendil-works/pi-tui";
+import { AssistantMessageComponent } from "./components/assistant-message.ts";
+import { SkillInvocationMessageComponent } from "./components/skill-invocation-message.ts";
+import { UserMessageComponent } from "./components/user-message.ts";
+
+/** Downstream presentation only. `children` always retains the native transcript. */
+export class ChatTranscript extends Container {
+	chatOnly = true;
+	readonly transcriptPositions = new Map<boolean, { top: number; follow: boolean }>();
+	private readonly notices = new WeakSet<Component>();
+	private readonly replacements = new WeakMap<Component, Component | null>();
+
+	private readonly unsettled = new Set<Component>();
+	private running = false;
+	private visible = new Container();
+	private readonly userBoundaries = new Set<number>();
+
+	startUserMessage(): void {
+		this.userBoundaries.add(this.children.length);
+	}
+
+	setQuietReplacement(original: Component, replacement: Component | null): void {
+		this.replacements.set(original, replacement);
+	}
+
+	keepVisible(component: Component): void {
+		this.notices.add(component);
+	}
+
+	beginRun(): void {
+		this.running = true;
+	}
+
+	settle(): boolean {
+		const failed = [...this.unsettled].some((child) => child instanceof AssistantMessageComponent && child.isFailure);
+		this.running = false;
+		this.unsettled.clear();
+		return failed;
+	}
+
+	override addChild(component: Component): void {
+		super.addChild(component);
+		if (this.running && component instanceof AssistantMessageComponent) this.unsettled.add(component);
+	}
+
+	override clear(): void {
+		super.clear();
+		this.transcriptPositions.clear();
+		this.unsettled.clear();
+		this.userBoundaries.clear();
+	}
+
+	override invalidate(): void {
+		super.invalidate();
+		for (const child of this.children) this.replacements.get(child)?.invalidate();
+	}
+
+	override handleMouse(event: TuiMouseEvent): ReturnType<Container["handleMouse"]> {
+		return this.visible.handleMouse(event);
+	}
+
+	override render(width: number): string[] {
+		const finals = new Set<Component>();
+		let last: AssistantMessageComponent | undefined;
+		const finish = () => {
+			if (last?.isFinalReply && !this.unsettled.has(last)) finals.add(last);
+			last = undefined;
+		};
+		for (const [index, child] of this.children.entries()) {
+			if (
+				this.userBoundaries.has(index) ||
+				child instanceof UserMessageComponent ||
+				child instanceof SkillInvocationMessageComponent
+			)
+				finish();
+			if (child instanceof AssistantMessageComponent) last = child;
+		}
+		finish();
+		const children = this.chatOnly
+			? this.children.flatMap((child) => {
+					const replacement = this.replacements.get(child);
+					return replacement === null ? [] : [replacement ?? child];
+				})
+			: this.children;
+		this.visible.children = children.filter((child) => {
+			if (child instanceof AssistantMessageComponent) {
+				child.setChatOnly(this.chatOnly);
+				return !this.chatOnly || finals.has(child) || child.isFailure;
+			}
+			return !this.chatOnly || child instanceof UserMessageComponent || this.notices.has(child);
+		});
+		return this.visible.render(width);
+	}
+}
