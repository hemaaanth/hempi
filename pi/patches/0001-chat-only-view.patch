+for (const cancelled of [false, true]) {
+	for (const path of ["live", "intercepted", "replay"] as const) {
+		test(`${path} keeps a concise user bash ${cancelled ? "cancellation" : "failure"}`, async () => {
+			initTheme("dark");
+			const chat = new ChatTranscript();
+			const result = { output: "HUGE_BASH_OUTPUT\n".repeat(100), exitCode: cancelled ? undefined : 1, cancelled };
+			const context = {
+				chatContainer: chat,
+				outputPad: 1,
+				ui: { requestRender: vi.fn() },
+				sessionManager: { getCwd: () => "/tmp" },
+				session: {
+					isStreaming: false,
+					extensionRunner: { emitUserBash: async () => (path === "intercepted" ? { result } : undefined) },
+					executeBash: vi.fn(async (_command: string, onChunk: (chunk: string) => void) => {
+						onChunk(result.output);
+						return result;
+					}),
+					recordBashResult: vi.fn(),
+				},
+				preserveBashFailure: Reflect.get(InteractiveMode.prototype, "preserveBashFailure"),
+			};
+			if (path === "replay") {
+				Reflect.apply(Reflect.get(InteractiveMode.prototype, "addMessageToChat"), context, [
+					{ role: "bashExecution", command: "false", ...result },
+				]);
+			} else {
+				await Reflect.apply(Reflect.get(InteractiveMode.prototype, "handleBashCommand"), context, ["false"]);
+			}
+			expect(output(chat)).toContain("!false");
+			expect(output(chat)).toContain(cancelled ? "Operation cancelled" : "Exit code: 1");
+			expect(output(chat)).not.toContain("HUGE_BASH_OUTPUT");
+			chat.chatOnly = false;
+			expect(output(chat)).toContain("HUGE_BASH_OUTPUT");
+		});
+	}
+}
