{
  "name": "hempi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.10.0"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:ci": "node scripts/test-isolated.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "test": "npm run typecheck && npm run test:privacy && npm run test:downstream && npm run test:model-route && npm run test:acp && npm run test:workflows && npm run test:runtime && npm run test:optchat && npm run test:optchat-activity && npm run test:watermark",
    "test:workflows": "node --test --test-timeout=30000 tests/workflows.test.ts",
    "test:acp": "node --test --test-timeout=30000 tests/acp-*.test.ts",
    "test:privacy": "node --test tests/privacy.test.mjs",
    "test:watermark": "timeout 15 node --input-type=module -e \"import('./tests/watermark.ts').then(m => m.default())\"",
    "test:model-route": "node --test tests/model-route.test.mjs",
    "test:downstream": "node --test tests/downstream-*.test.mjs",
    "pi:update": "node pi/channel.mjs update",
    "pi:status": "node pi/channel.mjs status",
    "pi:setup": "node pi/channel.mjs setup",
    "pi:rollback": "node pi/channel.mjs rollback",
    "pi:stock": "node pi/channel.mjs stock",
    "test:runtime": "timeout 60 \"${HEMPI_PI_TEST_BINARY:-pi}\" --mode rpc --no-session --no-extensions --no-skills -e ./tests/runtime.ts </dev/null",
    "test:optchat": "node --test --test-timeout=90000 tests/optchat.test.mjs",
    "test:optchat-activity": "node --test tests/optchat-activity.test.ts && timeout 60 \"${HEMPI_PI_TEST_BINARY:-pi}\" --mode rpc --no-session --no-extensions --no-skills --offline -e ./tests/optchat-activity-runtime.ts </dev/null"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^26.6.4",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.93.0",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@agentclientprotocol/sdk": "1.9.0",
    "proper-lockfile": "4.1.2"
  }
}
